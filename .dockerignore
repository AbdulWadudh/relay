# Rebuilt inside the image — copying them in would both bloat the build
# context and risk a host-platform artefact overwriting the Linux one.
node_modules
.next
*.tsbuildinfo

# Never leaves the developer's machine.
.git
.env
.env.*
!.env.example

# Local SQLite database and media scratch space.
data
*.db
*.db-shm
*.db-wal

# Tooling and documentation: read by people, not by the build.
.claude
.gstack
.qa
.vscode
.idea
graphify-out
*.md
Dockerfile
docker-compose.yml

# Throwaway verification probes. `_`-prefixed by convention and never
# committed, but the runtime stage does `COPY scripts ./scripts`, so without
# this an untracked script that decrypts the vault would ship to production
# just because it happened to be in the working tree at build time.
scripts/_*.ts
