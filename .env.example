# All env vars are consumed ONLY via src/config/index.ts (RULES.md).

# --- App ---
APP_BASE_URL=http://localhost:3000
PORT=3000
HOST=localhost
ALLOWED_HOSTS=

# --- Authentication ---
# Better Auth uses the existing VAULT_KEY for session signing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Security (TRD §4) ---
# 32-byte hex key for AES-256-GCM credential encryption.
# Generate: bun -e "console.log(crypto.getRandomValues(new Uint8Array(32)).toHex())"
VAULT_KEY=

# --- Drizzle Gateway ---
# Master password for the remote database browser.
# Generate: openssl rand -base64 24
STUDIO_PASSWORD=

# --- Database ---
# Local Bun-native sqlite by default; turso://... normalizes to libsql://.
DATABASE_URL=file:./local.db
DATABASE_TOKEN=

# --- Links ---
# Favicon service for link hosts with no bundled brand mark ({host} is
# substituted). Requested by the browser, so blank it to stop any
# third-party call and use a generic link glyph instead.
FAVICON_SERVICE_URL=https://icons.duckduckgo.com/ip3/{host}.ico

# --- Job queue (Task 4.2) ---
# Dragonfly (Redis-compatible) backing BullMQ. The server MUST be started
# with --default_lua_flags=allow-undeclared-keys, or every job fails with
# "script tried accessing undeclared key" — see docker-compose.yml.
REDIS_URL=redis://127.0.0.1:6379
QUEUE_CONCURRENCY=2
QUEUE_ATTEMPTS=2
QUEUE_BACKOFF_MS=5000
# Loopback-only liveness endpoint for the worker process. Must match the
# port the worker service's healthcheck probes in docker-compose.yml.
QUEUE_HEALTH_PORT=3001
# How many runs ONE user may have executing at once. BullMQ OSS has no job
# groups and its limiter is global, so this is a Dragonfly semaphore. It is
# fairness AND correctness: two runs sharing one cookie jar both write the
# rotated jar back on exit and the loser clobbers a live session.
# WARNING: raising this above 1 requires re-keying the semaphore on the
# credential id for cookie-bearing runs.
QUEUE_PER_USER_CONCURRENCY=1
# Crash-safety net on that semaphore, not a runtime budget: a worker killed
# mid-run releases its slot by expiry rather than wedging the user forever.
# Must exceed the longest plausible run (30 min against a ~330 s worst case).
QUEUE_USER_SLOT_TTL_MS=1800000
# How long a run waits before re-checking a busy user slot.
QUEUE_DEFER_MS=2000

# --- Media engine (PRD §4.1) ---
# Host binaries the pipeline shells out to. Leave blank to use PATH; the
# Docker image installs both. Set an absolute path if they aren't on the
# service account's PATH.
# Ceiling on one chat completion; a free model that accepts a request and
# never answers must not hang the run.
LLM_TIMEOUT_MS=120000
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# yt-dlp `player_client` fallbacks, tried in order when YouTube resolves the
# metadata but then refuses the MEDIA fetch with a 403. Measured 2026-09-01:
# the default client chain 403s on about HALF of items (ordinary Shorts
# included), while each of these served every item the default chain lost.
# `tv`, `android_vr` and `ios` do NOT work — this is not "any non-default
# client". YouTube changes which clients it serves without notice, so this is
# tunable without a redeploy. Blank it to disable the retry entirely.
YT_DLP_YOUTUBE_CLIENTS=web_embedded,mweb,tv_simply
# Per-run scratch space for downloaded media. Purged after every run; kept
# inside the mounted data volume by default so it can't fill the container
# filesystem unnoticed.
MEDIA_TEMP_DIR=./data/tmp

# --- Social sessions, once imported (SESSION_AUTH.md §4.3) ---
# How many consecutive login-shaped rejections a stored cookie jar takes
# before the Vault row offers "Reconnect". Two, not one: a single transient
# checkpoint should not nag a user whose session is actually fine. Any
# successful download resets the counter.
SOCIAL_STALE_AFTER_REJECTS=2
# Rolling-window download budget for ONE captured session, keyed on the
# CREDENTIAL (the account is what gets flagged), not the user. Each yt-dlp
# fetch is several requests; 10/hour sits about an order of magnitude under
# what the source tolerates and well inside human browsing behaviour.
SOCIAL_RATE_PER_HOUR=10
# Catches the slow burn the hourly cap misses (10/hr sustained = 240/day,
# which looks nothing like a person). Should never bind in practice — it is
# here to stop a runaway loop. Over budget DELAYS a run, never fails it.
SOCIAL_RATE_PER_DAY=50

# --- Ollama (local + cloud LLMs) ---
# LOCAL is a development convenience and is OFF by default. It is keyless,
# so leaving it on in production would register a provider with nothing
# listening on 11434 and waste an extraction attempt on every run.
# Start it with `ollama serve`, then pull a model, e.g.
#   ollama pull gemma4:12b
# Model ids are never written in code — the pipeline discovers them from
# GET /v1/models and ranks them, so pulling a model is all that is needed.
OLLAMA_LOCAL_ENABLED=false
OLLAMA_LOCAL_URL=http://127.0.0.1:11434/v1
# CLOUD is ordinary BYOK: create a key at https://ollama.com/settings/keys
# and add it in the Vault as the "Ollama Cloud" provider. Nothing goes in
# this file — keys live encrypted in the credentials vault.
OLLAMA_CLOUD_URL=https://ollama.com/v1

# --- Notion Ray (public integration) ---
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- Observability (OpenObserve) ---
# Leave blank to log to console only (local development).
OPENOBSERVE_URL=
OPENOBSERVE_ORG=default
# Include the complete header value, for example: Basic <token>
OPENOBSERVE_TOKEN=
NEXT_PUBLIC_OPENOBSERVE_CLIENT_TOKEN=
NEXT_PUBLIC_OPENOBSERVE_APPLICATION_ID=relay-app
NEXT_PUBLIC_OPENOBSERVE_SITE=
NEXT_PUBLIC_OPENOBSERVE_ORG=
NEXT_PUBLIC_OPENOBSERVE_SERVICE=relay-app
NEXT_PUBLIC_OPENOBSERVE_VERSION=0.1.0
