# All env vars are consumed ONLY via src/config/index.ts (RULES.md).

# --- App ---
APP_BASE_URL=http://localhost:3000
PORT=3000
HOST=localhost
ALLOWED_HOSTS=

# --- Security (TRD §4) ---
# 32-byte hex key for AES-256-GCM credential encryption.
# Generate: bun -e "console.log(crypto.getRandomValues(new Uint8Array(32)).toHex())"
VAULT_KEY=

# --- Database ---
# Local Bun-native sqlite by default; turso://... normalizes to libsql://.
DATABASE_URL=file:./local.db
DATABASE_TOKEN=

# --- Notion OAuth (public integration) ---
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- Observability (OpenObserve) ---
# Leave blank to log to console only (local development).
OPENOBSERVE_URL=
OPENOBSERVE_ORG=default
OPENOBSERVE_USER=
OPENOBSERVE_TOKEN=
