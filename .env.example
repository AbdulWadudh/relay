# --- Security (TRD §4) ---
# 32-byte hex key for AES-256-GCM credential encryption.
# Generate: bun -e "console.log(crypto.getRandomValues(new Uint8Array(32)).toHex())"
MASTER_ENCRYPTION_KEY=

# --- Database ---
# Optional; defaults to ./data/relay.db
RELAY_DB_PATH=

# --- Observability (OpenObserve) ---
# Leave blank to log to console only (local development).
OPENOBSERVE_URL=
OPENOBSERVE_ORG=default
OPENOBSERVE_USER=
OPENOBSERVE_TOKEN=
