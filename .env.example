# All env vars are consumed ONLY via src/config/index.ts (RULES.md).

# --- App ---
APP_BASE_URL=http://localhost:3000
PORT=3000
HOST=localhost
ALLOWED_HOSTS=

# --- Authentication ---
# Better Auth uses the existing VAULT_KEY for session signing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Security (TRD §4) ---
# 32-byte hex key for AES-256-GCM credential encryption.
# Generate: bun -e "console.log(crypto.getRandomValues(new Uint8Array(32)).toHex())"
VAULT_KEY=

# --- Drizzle Gateway ---
# Master password for the remote database browser. Coolify can temporarily use
# the legacy DRIZZLE_MASTERPASS value while migrating this variable name.
STUDIO_PASSWORD=

# --- Database ---
# Local Bun-native sqlite by default; turso://... normalizes to libsql://.
DATABASE_URL=file:./local.db
DATABASE_TOKEN=

# --- Notion OAuth (public integration) ---
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- Observability (OpenObserve) ---
# Leave blank to log to console only (local development).
OPENOBSERVE_URL=
OPENOBSERVE_ORG=default
# Include the complete header value, for example: Basic <token>
OPENOBSERVE_TOKEN=
NEXT_PUBLIC_OPENOBSERVE_CLIENT_TOKEN=
NEXT_PUBLIC_OPENOBSERVE_APPLICATION_ID=relay-app
NEXT_PUBLIC_OPENOBSERVE_SITE=
NEXT_PUBLIC_OPENOBSERVE_ORG=
NEXT_PUBLIC_OPENOBSERVE_SERVICE=relay-app
NEXT_PUBLIC_OPENOBSERVE_VERSION=0.1.0
